APP_NAME=CloudMail Key Panel
APP_SECRET_KEY=change-me-to-a-random-long-string
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me
APP_PORT=38080
DATABASE_PATH=./data/app.db
CLOUDMAIL_BASE_URL=https://your-cloudmail-domain.example.com
CLOUDMAIL_ADMIN_EMAIL=admin@example.com
CLOUDMAIL_ADMIN_PASSWORD=change-me
# Optional: provide a fixed token instead of email/password auth
# CLOUDMAIL_API_TOKEN=
# Optional: how many recent emails to show per key lookup
LOOKUP_EMAIL_LIMIT=10
# 兑换卡会话和领取任务有效期
REDEMPTION_SESSION_HOURS=24
REDEMPTION_CLAIM_MINUTES=30
# 连续 3 次未接码跳过后冷却 15 分钟
REDEMPTION_SKIP_LIMIT=3
REDEMPTION_SKIP_COOLDOWN_MINUTES=15
# 首页本地近期邮箱最大展示数量
PUBLIC_RECENT_MAILBOX_LIMIT=20
